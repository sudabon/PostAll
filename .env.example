# Local stack: `supabase start` then `supabase status -o env`.
# DATABASE_URL is the direct local DB (54322); the local stack has no separate
# pooler port. In production, migrate/emoji-sync use the Session pooler (5432)
# and the API server uses the Transaction pooler (6543). See README.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_REGION=local
S3_BUCKET=attachments
EMOJI_S3_BUCKET=emojis
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CRON_SECRET=dev-cron-secret
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
